# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
BASE_URL=https://your-ngrok-or-server-url.com

# ElevenLabs Speech-to-Text
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optional: STT model (default: scribe_v1)
ELEVENLABS_STT_MODEL=scribe_v1

# OpenRouter LLM
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free

# MiniMax Text-to-Speech
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_MODEL=speech-2.8-hd
MINIMAX_VOICE_ID=male-qn-qingse

# Redis
REDIS_CONNECTION_STRING=redis://localhost:6379

# Qdrant vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# Embedding service (used by Qdrant for semantic search)
EMBEDDING_API_URL=https://your-openai-endpoint/v1/embeddings
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_MODEL=text-embedding-ada-002

# Server
PORT=3000
