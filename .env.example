# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
BASE_URL=https://your-ngrok-or-server-url.com

# Azure Speech-to-Text
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# OpenClaw LLM (internal service)
OPENCLAW_API_URL=http://internal-openclaw-service/api/chat
OPENCLAW_API_KEY=your_openclaw_api_key

# MiniMax Text-to-Speech
MINIMAX_API_URL=https://api.minimax.chat/v1/text_to_speech
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_minimax_group_id
MINIMAX_VOICE_ID=male-qn-qingse

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# Embedding service (used by Qdrant for semantic search)
EMBEDDING_API_URL=https://your-openai-endpoint/v1/embeddings
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_MODEL=text-embedding-ada-002

# Server
PORT=3000
