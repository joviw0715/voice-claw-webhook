# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+19206968892
BASE_URL=https://your-ngrok-or-server-url.com
TWILIO_LANGUAGE=zh-HK

# Voice Assistant Configuration
FIRST_MESSAGE=你好，我係你嘅智能助手，有咩可以幫到你？
SYSTEM_PROMPT=You are a helpful voice assistant. Always reply in Cantonese.

# Azure Speech-to-Text
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastasia
AZURE_SPEECH_LANGUAGE=zh-HK

# OpenClaw LLM (primary, HTTP)
# Use internal Zeabur address for lower latency when both services are on Zeabur:
# OPENCLAW_URL=http://openclaw.zeabur.internal:18789
OPENCLAW_URL=https://voiceclaw.zeabur.app
OPENCLAW_TOKEN=your_openclaw_token

# LLM Configuration (OpenRouter fallback)
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=your_openrouter_api_key
LLM_MODEL=deepseek/deepseek-chat:free

# MiniMax Text-to-Speech
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_MODEL=speech-02-turbo
MINIMAX_VOICE_ID=Cantonese_GentleLady
MINIMAX_LANGUAGE_BOOST=Chinese,Yue

# Redis
REDIS_CONNECTION_STRING=redis://localhost:6379

# Qdrant vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# Embedding service (used by Qdrant for semantic search)
EMBEDDING_API_URL=https://your-openai-endpoint/v1/embeddings
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_MODEL=text-embedding-ada-002

# Media Streams (streaming architecture — set to 'true' to enable, 'false' for legacy record/webhook)
USE_MEDIA_STREAMS=false

# Azure TTS voice for streaming path (streaming uses Azure TTS, legacy uses MiniMax)
AZURE_TTS_VOICE=zh-HK-HiuGaaiNeural

# Server
PORT=3000
