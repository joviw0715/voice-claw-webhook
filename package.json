{
  "name": "voice-claw-webhook",
  "version": "1.0.0",
  "description": "Twilio voice AI assistant webhook using Azure STT, OpenClaw LLM, MiniMax TTS, Redis, and Qdrant",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "NODE_ENV=test node --test 'test/**/*.test.js' 'test/*.test.js'",
    "test:watch": "NODE_ENV=test node --test --watch 'test/**/*.test.js' 'test/*.test.js'"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "1.18.0",
    "axios": "1.16.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "ioredis": "5.10.1",
    "microsoft-cognitiveservices-speech-sdk": "^1.42.0",
    "modesl": "^1.2.1",
    "twilio": "6.0.2",
    "ws": "^8.20.1"
  }
}
